# Brightflow Environment Configuration
# Copy to .env and customize for local development

# API Server
BRIGHTFLOW_API_PORT=8080
BRIGHTFLOW_API_HOST=127.0.0.1

# Data directory (all workspace paths derived from this)
# Structure: {BRIGHTFLOW_DATA_DIR}/workspaces/default/{store,schemas,connector-configs,auth.db,scheduler.db}
# BRIGHTFLOW_DATA_DIR=./data

# Data (individual overrides — only needed if not using BRIGHTFLOW_DATA_DIR)
BRIGHTFLOW_DEFAULT_DATASET=./data/sample.csv
# BRIGHTFLOW_STORE=./data/store
# BRIGHTFLOW_SCHEMA_DIR=./schemas
# BRIGHTFLOW_CONNECTOR_CONFIGS=./configs
# BRIGHTFLOW_DATABASE_URL=sqlite:data/auth.db?mode=rwc

# Admin auto-seed (creates admin user on first startup if auth DB is empty)
# BRIGHTFLOW_ADMIN_EMAIL=admin@example.com
# BRIGHTFLOW_ADMIN_PASSWORD=changeme

# Logging (used by tracing-subscriber)
RUST_LOG=brightflow=info,brightflow_api=debug,tower_http=debug
