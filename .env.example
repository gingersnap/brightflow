# Brightflow Environment Configuration
# Copy to .env and customize for local development

# API Server
BRIGHTFLOW_API_PORT=8080
BRIGHTFLOW_API_HOST=127.0.0.1

# Data directory — all paths derived from this
# Structure: {DATA_DIR}/workspaces/{WORKSPACE}/
#   store/              parquet files
#   litehouse.db        store metadata
#   auth.db             users/sessions
#   scheduler.db        scheduler jobs
#   schemas/            schema TOML files
#   connector-configs/  connector config files
BRIGHTFLOW_DATA_DIR=./data
# BRIGHTFLOW_WORKSPACE=default

# Default CSV dataset to auto-load on startup (optional)
# BRIGHTFLOW_DEFAULT_DATASET=./data/sample.csv

# Admin auto-seed (creates admin user on first startup if auth DB is empty)
# BRIGHTFLOW_ADMIN_EMAIL=admin@example.com
# BRIGHTFLOW_ADMIN_PASSWORD=changeme

# Logging
RUST_LOG=brightflow=info,brightflow_api=debug,tower_http=debug

# GitHub token for data connectors (optional)
# GITHUB_TOKEN=ghp_your_token_here

# Advanced: override individual paths (usually not needed)
# BRIGHTFLOW_STORE=./custom/store
# BRIGHTFLOW_DATABASE_URL=sqlite:./custom/auth.db?mode=rwc
# BRIGHTFLOW_SCHEMA_DIR=./custom/schemas
# BRIGHTFLOW_CONNECTOR_CONFIGS=./custom/configs
# BRIGHTFLOW_LITEHOUSE_URL=sqlite:./custom/litehouse.db?mode=rwc
# BRIGHTFLOW_SCHEDULER_DATABASE_URL=sqlite:./custom/scheduler.db?mode=rwc
