#!/usr/bin/env bash
#
# Pre-commit hook for Brightflow
# Runs Rust and TypeScript checks before allowing a commit
#
# Install: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get the root directory of the repo
ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

echo -e "${BLUE}Running pre-commit checks...${NC}"
echo ""

FAILED=0

# ============================================
# Conventions (diff-scoped, cheap — runs first)
# ============================================

echo -e "${BLUE}[Conventions]${NC} Checking staged files..."
if ! bash "$ROOT_DIR/scripts/check-conventions.sh"; then
    FAILED=1
fi

# ============================================
# Rust Checks
# ============================================

echo -e "${BLUE}[Rust]${NC} Checking formatting..."
if ! cargo fmt --all -- --check 2>/dev/null; then
    echo -e "${RED}✗ Rust formatting check failed${NC}"
    echo "  Run 'cargo fmt' to fix"
    FAILED=1
else
    echo -e "${GREEN}✓ Rust formatting${NC}"
fi

echo -e "${BLUE}[Rust]${NC} Running Clippy..."
if ! cargo clippy --all-targets --all-features -- -D warnings 2>/dev/null; then
    echo -e "${RED}✗ Clippy found issues${NC}"
    FAILED=1
else
    echo -e "${GREEN}✓ Clippy${NC}"
fi

# cargo audit is optional (requires cargo-audit to be installed).
#
# Deliberately notify-only and --no-fetch: a commit hook must not block on the network,
# and it must not block a commit on an advisory the committer didn't introduce. The
# consequence is that this check reads against whatever advisory DB happens to be on
# disk, so a "0 vulnerabilities" line here means "nothing known locally", NOT "audited
# clean" — the messages below say so. ./scripts/audit.sh is the real gate: it fetches a
# fresh DB and exits non-zero.
if command -v cargo-audit &> /dev/null; then
    echo -e "${BLUE}[Rust]${NC} Running security audit (local DB, advisory only)..."
    AUDIT_JSON=$(cargo audit --format json --no-fetch 2>/dev/null || true)
    VULN_COUNT=$(echo "$AUDIT_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin)['vulnerabilities']['count'])" 2>/dev/null || echo "?")
    if [ "$VULN_COUNT" != "0" ]; then
        echo -e "${YELLOW}⚠ Security audit: $VULN_COUNT vulnerabilities found${NC}"
        echo "$AUDIT_JSON" | python3 -c "
import sys, json
d = json.load(sys.stdin)
for v in d['vulnerabilities']['list']:
    a, p = v['advisory'], v['package']
    patched = ', '.join(str(x) for x in v.get('versions', {}).get('patched', []))
    fix = f' (fix: {patched})' if patched else ''
    print(f\"  {a['id']} {p['name']}@{p['version']}: {a['title'][:70]}{fix}\")
for wt in ['unmaintained', 'yanked']:
    items = d.get('warnings', {}).get(wt, [])
    if items:
        print(f'  Warnings ({wt}): ' + ', '.join(f\"{w['package']['name']}@{w['package']['version']}\" for w in items))
" 2>/dev/null
        echo -e "  ${YELLOW}Not blocking this commit. Run ./scripts/audit.sh to gate properly.${NC}"
    elif [ "$VULN_COUNT" = "?" ]; then
        echo -e "${YELLOW}⚠ Security audit could not be parsed — treat as unknown, not clean${NC}"
        echo -e "  Run ${BLUE}./scripts/audit.sh${NC}"
    else
        # Not "✓ Security audit" — this ran against a possibly-stale local DB and says
        # nothing about advisories published since it was last fetched.
        echo -e "${GREEN}✓ No advisories in local DB${NC} ${YELLOW}(not fetched — run ./scripts/audit.sh for a real audit)${NC}"
    fi
else
    echo -e "${YELLOW}[Rust] Skipping audit (cargo-audit not installed)${NC}"
    echo -e "  Install with 'cargo install cargo-audit', then run ./scripts/audit.sh"
fi

# ============================================
# Rust Tests + TypeScript Type Generation
# ============================================

echo -e "${BLUE}[Rust]${NC} Running tests (generates TypeScript types)..."
if ! TS_RS_EXPORT_DIR="$ROOT_DIR/brightflow-app/src/types/generated" cargo test --workspace 2>/dev/null; then
    echo -e "${RED}✗ Rust tests failed${NC}"
    FAILED=1
else
    echo -e "${GREEN}✓ Rust tests & type generation${NC}"
    # Regenerate the barrel from the directory listing, so index.ts is
    # derived output like every other file in generated/ (never hand-edited)
    "$ROOT_DIR/scripts/generate-ts-barrel.sh"
    # Format generated types to match project conventions
    if [ -d "$ROOT_DIR/brightflow-app/node_modules" ]; then
        (cd "$ROOT_DIR/brightflow-app" && npx vp fmt src/types/generated/ 2>/dev/null) || true
    fi
    # Stage updated generated types
    git add "$ROOT_DIR/brightflow-app/src/types/generated/"*.ts 2>/dev/null || true
fi

# ============================================
# TypeScript/Frontend Checks
# ============================================

if [ -d "$ROOT_DIR/brightflow-app" ]; then
    cd "$ROOT_DIR/brightflow-app"

    # Check if node_modules exists
    if [ ! -d "node_modules" ]; then
        echo -e "${YELLOW}[Frontend] node_modules not found, skipping checks${NC}"
        echo "  Run 'npm install' in brightflow-app to enable"
    else
        echo -e "${BLUE}[Frontend]${NC} Running staged checks (types + lint + format)..."
        if ! npx vp staged 2>/dev/null; then
            echo -e "${RED}✗ Frontend checks failed${NC}"
            echo "  Run 'npm run check:fix' in brightflow-app to fix"
            FAILED=1
        else
            echo -e "${GREEN}✓ Frontend checks${NC}"
            # Stage any auto-fixed formatting (auto-imports.d.ts, components.d.ts, etc.)
            git add "$ROOT_DIR/brightflow-app"/*.d.ts 2>/dev/null || true
        fi

        # Whole-project on purpose, not staged-scoped: deleting a store or
        # composable member breaks .vue consumers that are NOT in the diff, and
        # tsgolint does not type-check .vue script blocks at all. Temporary
        # second checker — remove when Vite+/tsgolint covers .vue (see
        # brightflow-app/CLAUDE.md, ".vue type-checking").
        echo -e "${BLUE}[Frontend]${NC} Type-checking .vue components (vue-tsc)..."
        if ! npx vue-tsc --noEmit; then
            echo -e "${RED}✗ vue-tsc found type errors${NC}"
            FAILED=1
        else
            echo -e "${GREEN}✓ vue-tsc${NC}"
        fi

        # --run forces non-watch mode: the hook must never block on a watcher.
        echo -e "${BLUE}[Frontend]${NC} Running unit tests..."
        if ! npx vp test --run 2>/dev/null; then
            echo -e "${RED}✗ Frontend tests failed${NC}"
            FAILED=1
        else
            echo -e "${GREEN}✓ Frontend tests${NC}"
        fi
    fi
fi

# ============================================
# Summary
# ============================================

echo ""
if [ $FAILED -eq 1 ]; then
    echo -e "${RED}Pre-commit checks failed. Please fix the issues above.${NC}"
    echo -e "To bypass (not recommended): git commit --no-verify"
    exit 1
else
    echo -e "${GREEN}All pre-commit checks passed!${NC}"
    exit 0
fi
