{
  "name": "brightflow-app",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "npm run type-check && npm run lint && npm run format:check"
  },
  "description": "Brightflow web application",
  "dependencies": {
    "@pinia/colada": "^1.0.0",
    "echarts": "^6.0.0",
    "lucide-vue-next": "^0.562.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.26",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@nuxt/ui": "^4.6.0",
    "@types/node": "^25.2.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "oxlint": "^1.43.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vue-tsc": "^3.2.4"
  }
}
